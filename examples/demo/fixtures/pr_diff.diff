diff --git a/tests/test_transport.py b/tests/test_transport.py
index 5f0c8b1..2ad7e93 100644
--- a/tests/test_transport.py
+++ b/tests/test_transport.py
@@ -12,3 +12,19 @@ def test_returns_first_success(monkeypatch):
     assert transport.request("GET", "https://example.com/x").status_code == 200


+def test_backoff_is_capped():
+    assert transport.retry_with_jitter(40) <= transport.MAX_DELAY
+
+
+def test_retry_after_header_wins():
+    assert transport.retry_with_jitter(0, retry_after="12") == 12.0
+
+
+def test_post_is_not_retried(monkeypatch):
+    calls = []
+
+    def fail(*a, **kw):
+        calls.append(1)
+        raise httpx.TimeoutException("slow")
+
+    monkeypatch.setattr(httpx, "request", fail)
+    with pytest.raises(transport.TransportError):
+        transport.request("POST", "https://example.com/x")
+    assert len(calls) == 1
